[Unit]
Description=Gravel Road FastAPI
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=oguntoye
WorkingDirectory=/home/oguntoye/GravelRoad_Iowa/FastAPI
EnvironmentFile=/home/oguntoye/GravelRoad_Iowa/FastAPI/.env
ExecStart=/home/oguntoye/.local/bin/uv run gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 127.0.0.1:8000 --workers 8 --max-requests 100 --max-requests-jitter 20
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
